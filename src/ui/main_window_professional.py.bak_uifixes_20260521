    def _on_loop_demo_status(self, message: str) -> None:
        """Update Loop Demo status label and button state (call on main thread)."""
        self.loop_demo_status_label.setText(message)
        # Append timestamped entry to the event log.
        ts = datetime.now().strftime("%H:%M:%S")
        self.loop_demo_event_log.appendPlainText(f"{ts}  {message}")
        # Trim to 200 lines.
        doc = self.loop_demo_event_log.document()
        while doc.blockCount() > 200:
            cursor = self.loop_demo_event_log.textCursor()
            cursor.movePosition(cursor.MoveOperation.Start)
            cursor.select(cursor.SelectionType.BlockUnderCursor)
            cursor.removeSelectedText()
            cursor.deleteChar()
        # Auto-scroll to bottom.
        self.loop_demo_event_log.verticalScrollBar().setValue(
            self.loop_demo_event_log.verticalScrollBar().maximum()
        )
        # Color the panel by phase: red for errors, green for running, gray for idle.
        msg_low = message.lower()
        if message in ("Command failed", "Disconnected") or "fail" in msg_low or "error" in msg_low:
            bg = "#DC3545"  # red
            self.add_log_message(f"Loop demo: {message}", "ERROR")
        elif "stop" in msg_low or message == "Idle":
            bg = "#6C757D"  # gray
        elif "complete" in msg_low or "done" in msg_low:
            bg = "#0D6EFD"  # blue
        else:
            bg = "#198754"  # green (running / executing a segment)
        self.loop_demo_status_label.setStyleSheet(
            "QLabel { font-size: 48px; font-weight: 800; color: #FFFFFF; "
            f"background-color: {bg}; border-radius: 16px; padding: 16px; "
            "letter-spacing: 1px; }"
        )
        running = self.loop_demo_runner is not None and self.loop_demo_runner.is_running()
        self.loop_demo_start_btn.setEnabled(not running)
        self.loop_demo_test_move_btn.setEnabled(not running and bool(self.saved_home_joints))
        self.loop_demo_stop_btn.setEnabled(running)

    def _loop_demo_start(self) -> None:
        """Start the loop demo with current audience direction, speed and delay. Requires saved home."""
        if not self.jog_controller:
            self.add_log_message("No jog controller", "ERROR")
            QMessageBox.warning(self, "Demo", "Robot not connected.")
            return
        if not self.saved_home_joints or len(self.saved_home_joints) != 6:
            self.add_log_message("No home position saved", "WARNING")
            QMessageBox.warning(
                self,
                "Demo",
                "Save a home position first (Safety panel: Save as home). The demo starts and ends at home.",
            )
            return
        if not self.jog_controller.websocket_controller or not self.jog_controller.websocket_controller.is_connected():
            self.add_log_message("Robot not connected", "ERROR")
            QMessageBox.warning(self, "Demo", "Connect to the robot first.")
            return
        if self.loop_demo_runner is not None and self.loop_demo_runner.is_running():
            return
        import math
        base_offset_deg = self.loop_demo_base_offset_spin.value()
        base_offset_rad = math.radians(base_offset_deg)
        speed_pct = self.loop_demo_speed_slider.value() / 100.0
        # Single-scaling: speed_scale (slider%) is the only knob; keep joint_speed constant.
        # Range: 10% -> 0.035 rad/s, 100% -> 0.35 rad/s base, modulated per-segment.
        joint_speed = 0.35
        waypoint_delay_s = self.loop_demo_delay_spin.value()
        demo_cfg = self.config.get("demo", {})
        blend_radius_rad = float(demo_cfg.get("blend_radius_rad", 0.15))
        send_interval_s = float(demo_cfg.get("send_interval_s", 0.08))
        joint_acceleration = float(demo_cfg.get("joint_acceleration", 0.28))
        # Clear event log and stamp the start time.
        self.loop_demo_event_log.clear()
        self.loop_demo_event_log.appendPlainText(
            f"--- Demo started: {datetime.now().strftime('%H:%M:%S')} ---"
        )
        status_callback = lambda msg: QTimer.singleShot(0, lambda m=msg: self._on_loop_demo_status(m))
        runner_cls = getattr(self, "_active_demo_class", DemoRunner)
        self.loop_demo_runner = runner_cls(
            self.jog_controller.websocket_controller,
            home_joints=self.saved_home_joints,
            audience_offset_rad=base_offset_rad,
            speed_scale=speed_pct,
            send_interval_s=send_interval_s,
            cycle_delay_s=waypoint_delay_s,
            joint_speed=joint_speed,
            joint_acceleration=joint_acceleration,
            blend_radius=blend_radius_rad,
            status_callback=status_callback,
        )
        if self.loop_demo_runner.start():
            self._on_loop_demo_status("Running")
            self.add_log_message("Loop demo started", "INFO")
        else:
            self._on_loop_demo_status("Start failed")
            self.add_log_message("Loop demo start failed", "WARNING")

    def _loop_demo_stop(self) -> None:
        """Stop the loop demo. Schedules a poll fallback in case the
        worker thread\u2019s final notify does not reach the UI."""
        if self.loop_demo_runner:
            self.loop_demo_runner.stop()
            self._on_loop_demo_status("Stopping...")
            self.add_log_message("Loop demo stop requested", "INFO")
            # Poll fallback: in 500ms check if the runner finished;
            # if so, force-update UI to Stopped (covers any notify-chain glitch).
            QTimer.singleShot(500, lambda: self._loop_demo_check_stopped(0))

    def _on_speed_slider_settled(self) -> None:
        """When the user settles on a new speed, restart the running demo."""
        runner = self.loop_demo_runner
        if runner is None or not runner.is_running():
            return  # idle: slider takes effect on next Start
        active_class = getattr(self, "_active_demo_class", None)
        if active_class is None:
            return
        self.add_log_message(
            f"Speed changed to {self.loop_demo_speed_slider.value()}%; restarting demo",
            "INFO",
        )
        self._loop_demo_stop()
        # Wait for stop to complete, then restart with current slider value.
        QTimer.singleShot(900, self._restart_after_speed_change)

    def _restart_after_speed_change(self) -> None:
        runner = self.loop_demo_runner
        if runner is not None and runner.is_running():
            QTimer.singleShot(300, self._restart_after_speed_change)
            return
        self._loop_demo_start()

    def _loop_demo_check_stopped(self, attempt: int) -> None:
        """Poll runner state; force UI to Stopped once is_running() == False."""
        runner = self.loop_demo_runner
        if runner is None or not runner.is_running():
            self._on_loop_demo_status("Stopped")
            self.add_log_message("Loop demo: confirmed stopped via poll", "INFO")
            return
        if attempt >= 20:  # 10 seconds total
            self.add_log_message("Loop demo: stop poll timed out, forcing UI Stopped", "WARNING")
            self._on_loop_demo_status("Stopped")
            return
        QTimer.singleShot(500, lambda a=attempt+1: self._loop_demo_check_stopped(a))

    def _loop_demo_test_move(self) -> None:
        """Send a single movej to saved home to verify the robot responds to commands."""
        if not self.jog_controller or not self.jog_controller.websocket_controller:
            QMessageBox.warning(self, "Demo", "Robot not connected.")
            return
        if not self.jog_controller.websocket_controller.is_connected():
            QMessageBox.warning(self, "Demo", "Connect to the robot first.")
            return
        if not self.saved_home_joints or len(self.saved_home_joints) != 6:
            QMessageBox.warning(self, "Demo", "Save a home position first (Safety panel: Save as home).")
            return
        self._on_loop_demo_status("Test move...")
        ok = self.jog_controller.websocket_controller.move_joint(
            self.saved_home_joints,
            speed=0.2,
            acceleration=0.25,
            blend=0.0,
        )
        if ok:
            self._on_loop_demo_status("Test move sent")
            self.add_log_message("Test move (movej to home) sent; check if robot moves", "INFO")
        else:
            self._on_loop_demo_status("Test move failed")
            self.add_log_message("Test move failed (send_command returned False)", "ERROR")

