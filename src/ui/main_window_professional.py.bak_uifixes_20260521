    def _create_protective_stop_overlay(self) -> QWidget:
        """Create full-screen overlay shown when robot is in protective stop. Appears on top of any page so user can recover from anywhere."""
        overlay = QFrame()
        overlay.setObjectName("protectiveStopOverlay")
        overlay.setStyleSheet(
            "QFrame#protectiveStopOverlay { background-color: rgba(0, 0, 0, 0.65); }"
        )
        overlay_layout = QVBoxLayout(overlay)
        overlay_layout.setAlignment(Qt.AlignmentFlag.AlignCenter)
        overlay_layout.setSpacing(24)

        card = QFrame()
        card.setObjectName("protectiveStopCard")
        card.setStyleSheet(
            "QFrame#protectiveStopCard { background-color: #FFFFFF; border-radius: 12px; "
            "border: 2px solid #F44336; padding: 24px; min-width: 420px; max-width: 520px; }"
        )
        card_layout = QVBoxLayout(card)
        card_layout.setSpacing(20)

        title = QLabel("Protective stop active")
        title.setStyleSheet("font-size: 22px; font-weight: bold; color: #B71C1C;")
        title.setAlignment(Qt.AlignmentFlag.AlignCenter)
        card_layout.addWidget(title)

        msg = QLabel(
            "The robot has entered protective stop. Resolve the cause (e.g. obstacle, limit), "
            "then click below to unlock and close the safety popup so you can continue."
        )
        msg.setWordWrap(True)
        msg.setStyleSheet("font-size: 14px; color: #212529;")
        msg.setAlignment(Qt.AlignmentFlag.AlignCenter)
        card_layout.addWidget(msg)

        unlock_btn = QPushButton("Unlock protective stop")
        unlock_btn.setObjectName("warningButton")
        unlock_btn.setMinimumHeight(56)
        unlock_btn.setCursor(Qt.CursorShape.PointingHandCursor)
        unlock_btn.setToolTip("Send unlock and close safety popup via Dashboard")
        unlock_btn.clicked.connect(self._on_protective_stop_unlock_clicked)
        card_layout.addWidget(unlock_btn)

        overlay_layout.addWidget(card)
        return overlay

