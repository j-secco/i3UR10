    # Event Handlers
    def _set_jog_mode(self, mode: str):
        """Set the jog mode (cartesian or joint)."""
        self.current_jog_mode = mode
        if self.jog_controller:
            self.jog_controller.set_jog_mode(mode)
        self.logger.info(f"Jog mode set to: {mode}")

    def _on_speed_changed(self, value: int):
        """Handle speed slider changes."""
        speed = value / 100.0  # Convert to 0.0-1.0 range
        self.speed_label.setText(f"Current Speed: {speed:.2f} m/s")
        # Note: JogController doesn't have set_jog_speed method
        # Speed is handled by the speed_scale parameter in start_jog()

    def _start_jog(self, axis: str, direction: int):
        """Start jogging in specified direction."""
        if self.jog_controller:
            # Map axis names to indices
            axis_map = {'x': 0, 'y': 1, 'z': 2, 'rx': 3, 'ry': 4, 'rz': 5,
                       'j1': 0, 'j2': 1, 'j3': 2, 'j4': 3, 'j5': 4, 'j6': 5}
            axis_index = axis_map.get(axis, 0)
            self.jog_controller.start_jog(axis_index, direction)
        self.logger.debug(f"Started jogging {axis} in direction {direction}")

    def _stop_jog(self):
        """Stop all jogging motion."""
        if self.jog_controller:
            self.jog_controller.stop_jog()
        self.logger.debug("Stopped jogging")

    def _emergency_stop(self):
        """Execute emergency stop."""
        if self.jog_controller:
            self.jog_controller.emergency_stop()
        self.logger.warning("Emergency stop activated")

    def _recover_protective_stop(self):
        """Unlock protective stop and close safety popup via Dashboard."""
        if not self.jog_controller or not self.jog_controller.dashboard_client:
            return
        dc = self.jog_controller.dashboard_client
        if not dc.is_connected():
            self.add_log_message("Dashboard not connected; cannot unlock protective stop", "WARNING")
            return
        ok1 = dc.unlock_protective_stop()
        ok2 = dc.close_safety_popup()
        if ok1 or ok2:
            self.add_log_message("Recovery sent: unlock protective stop=%s, close safety popup=%s" % (ok1, ok2), "INFO")
        else:
            self.add_log_message("Recovery may have failed; check teach pendant", "WARNING")

    def _on_protective_stop_unlock_clicked(self):
        """Called when user clicks Unlock on the overlay. Run recovery then hide overlay after a short delay."""
        self._recover_protective_stop()
        if hasattr(self, "_protective_stop_overlay"):
            QTimer.singleShot(1500, self._protective_stop_overlay.hide)

    def _toggle_connection(self):
        """Toggle robot connection."""
        if self.jog_controller:
            if hasattr(self.jog_controller, 'connected') and self.jog_controller.connected:
                # Disconnect
                self.jog_controller.disconnect()
                self._on_connection_status_changed(False)
                self.logger.info("Disconnected from robot")
            else:
                # Connect
                try:
                    success = self.jog_controller.connect()
                    if success:
                        self._on_connection_status_changed(True)
                        self.logger.info("Connected to robot")
                    else:
                        self.logger.error("Failed to connect to robot")
                        self.add_log_message("Connection failed", "ERROR")
                        self._on_connection_status_changed(False)
                except Exception as e:
                    self.logger.error(f"Connection error: {e}")
                    self.add_log_message(f"Connection error: {str(e)}", "ERROR")
                    self._on_connection_status_changed(False)

    def _show_settings(self):
        """Show configuration settings dialog."""
        try:
            from ui.widgets.config_dialog import ConfigDialog
            dialog = ConfigDialog(self.config, self, getattr(self, "jog_controller", None))
            if dialog.exec() == dialog.DialogCode.Accepted:
                # Update configuration
                new_config = dialog.get_config()
                if new_config:
                    self.config.update(new_config)
                    # Update displayed IP address
                    robot_ip = self.config.get('robot', {}).get('ip_address', 'Unknown')
                    self.ip_value_label.setText(robot_ip)
                    self.logger.info("Configuration updated")
                    self.add_log_message("Configuration updated", "INFO")
        except ImportError:
            self.logger.warning("Config dialog not available")
            self.add_log_message("Settings dialog not available", "WARNING")

    # Update Methods
    def _update_position_display(self):
        """Update position displays from stored position data."""
        try:
            cartesian = self.current_position.get('cartesian', {})
            units = getattr(self, "_position_units", {})
            for key, label in self.tcp_labels.items():
                value = cartesian.get(key, 0.0)
                unit = units.get(key, "")
                label.setText(f"{value:+.2f} {unit}".strip())

            joint = self.current_position.get('joint', {})
            for key, label in self.joint_labels.items():
                value = joint.get(key, 0.0)
                label.setText(f"{value:+.2f} deg")
        except Exception as e:
            self.logger.error(f"Error updating position display: {e}")

    def _update_status_display(self):
        """Update status displays."""
        if not self.jog_controller:
            return

        try:
            if hasattr(self.jog_controller, 'connected') and self.jog_controller.connected:
                self._on_connection_status_changed(True)
            else:
                self._on_connection_status_changed(False)

            status = self.jog_controller.get_robot_status()
            safety_defaults = {
                "robot_mode": str(status.get("robot_mode", "0")),
                "safety_mode": str(status.get("safety_mode", "0")),
                "protective_stop": "Yes" if status.get("protective_stopped") else "No",
                "remote_control": "Yes" if status.get("remote_control") else "No",
                "robot_error": (status.get("robot_error") or "").strip() or "-",
                "robot_warning": (status.get("robot_warning") or "").strip() or "-"
            }
            for key, label in self.safety_labels.items():
                value = safety_defaults.get(key, "0")
                label.setText(str(value)[:80])

            if hasattr(self, "recover_btn"):
                self.recover_btn.setVisible(bool(status.get("protective_stopped")))

            if status.get("protective_stopped"):
                self._protective_stop_clear_count = 0
                if hasattr(self, "_protective_stop_overlay"):
                    self._protective_stop_overlay.show()
                if not getattr(self, "_protective_stop_logged", False):
                    self._protective_stop_logged = True
                    self.add_log_message(
                        "Protective stop detected. Resolve the cause, then use 'Unlock protective stop' to recover.",
                        "WARNING"
                    )
            else:
                self._protective_stop_logged = False
                # Do not auto-hide the overlay when status says False (e.g. polling flicker).
                # Overlay is hidden only when the user clicks "Unlock protective stop" in _on_protective_stop_unlock_clicked.

        except Exception as e:
            self.logger.error(f"Error updating status display: {e}")

    def add_log_message(self, message: str, level: str = "INFO"):
        """Add a message to the log display."""
        timestamp = datetime.now().strftime("%H:%M:%S")
        formatted_message = f"[{timestamp}] [{level}] {message}"
        self.log_display.append(formatted_message)

        # Limit log display to prevent memory issues
        if self.log_display.document().blockCount() > 1000:
            cursor = self.log_display.textCursor()
            cursor.movePosition(cursor.MoveOperation.Start)
            cursor.select(cursor.SelectionType.LineUnderCursor)
            cursor.removeSelectedText()

    def _install_demo_log_handler(self) -> None:
        """Forward demo and controller logs to the in-app log panel for debugging."""
        def on_log(msg: str, level: str = "INFO") -> None:
            self.add_log_message(msg, level)

        handler = DemoLogHandler(on_log)
        handler.setFormatter(logging.Formatter("%(name)s | %(message)s"))
        for name in ("DemoRunner", "WebSocketController", "RTDEController"):
            logger = logging.getLogger(name)
            logger.addHandler(handler)
            logger.setLevel(logging.INFO)

    def _save_log_snapshot(self) -> None:
        """Save current log display content to logs/demo_snapshot_<timestamp>.txt."""
        try:
            log_dir = Path("logs")
            log_dir.mkdir(exist_ok=True)
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            path = log_dir / f"demo_snapshot_{timestamp}.txt"
            path.write_text(self.log_display.toPlainText(), encoding="utf-8")
            QMessageBox.information(
                self,
                "Log saved",
                "Log snapshot saved to:\n%s" % path.resolve(),
            )
        except Exception as e:
            QMessageBox.warning(self, "Save log failed", "Could not save log: %s" % e)

    def _export_logs(self) -> None:
        """Bundle logs/ and config/ into one timestamped .zip.

        Destination: a writable USB mounted under /media/<user>/ if present,
        otherwise the Desktop. Lets the operator hand over all diagnostics in
        one file without hunting through the filesystem.
        """
        import os
        import zipfile
        try:
            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
            archive_name = "i3UR10_logs_%s.zip" % timestamp

            # Prefer a writable USB drive under /media/<user>/; else the Desktop.
            dest_dir, dest_kind = Path.home() / "Desktop", "Desktop"
            media_root = Path("/media") / Path.home().name
            if media_root.is_dir():
                for entry in sorted(media_root.iterdir()):
                    if entry.is_dir() and os.access(entry, os.W_OK):
                        dest_dir, dest_kind = entry, "USB drive (%s)" % entry.name
                        break
            dest_dir.mkdir(parents=True, exist_ok=True)
            archive_path = dest_dir / archive_name

            files_added = 0
            with zipfile.ZipFile(archive_path, "w", zipfile.ZIP_DEFLATED) as zf:
                for folder in ("logs", "config"):
                    base = Path(folder)
                    if not base.is_dir():
                        continue
                    for f in sorted(base.rglob("*")):
                        if f.is_file():
                            zf.write(f, str(f))
                            files_added += 1

            if files_added == 0:
                QMessageBox.warning(self, "Export logs",
                                    "No log or config files were found to export.")
                return
            QMessageBox.information(
                self, "Logs exported",
                "Exported %d file(s) to %s:\n%s" % (files_added, dest_kind, archive_path.resolve()),
            )
            self.add_log_message("Logs exported to %s" % archive_path, "INFO")
        except Exception as e:
            QMessageBox.warning(self, "Export failed", "Could not export logs: %s" % e)

    def set_jog_controller(self, controller: JogController):
        """Set the jog controller instance."""
        self.jog_controller = controller
        if controller:
            # Update initial status
            robot_ip = controller.config.get('robot', {}).get('ip_address', 'Unknown')
            self.ip_value_label.setText(robot_ip)

            # Add position callback
            controller.add_position_callback(self._on_position_updated)

            # When position is pulled from robot after connect, refresh UI on main thread
            controller.add_position_fetched_callback(
                lambda: QTimer.singleShot(0, self._refresh_position_from_robot)
            )

            # When connection is established, refresh status immediately so protective-stop overlay appears
            def on_connection_changed(connected: bool) -> None:
                if connected:
                    QTimer.singleShot(0, self._update_status_display)
            controller.add_connection_callback(on_connection_changed)

    def _refresh_position_from_robot(self) -> None:
        """Refresh position display from controller (call on main thread after position fetched from robot)."""
        if not self.jog_controller:
            return
        tcp_pose = self.jog_controller.get_tcp_pose()
        joint_angles = self.jog_controller.get_joint_angles()
        self._on_position_updated(tcp_pose, joint_angles)

    def _on_position_updated(self, tcp_pose, joint_angles):
        """Handle position updates from controller."""
        # Convert callback data to our expected format
        if tcp_pose and len(tcp_pose) >= 6:
            self.current_position['cartesian'] = {
                'x': tcp_pose[0] * 1000,  # Convert to mm
                'y': tcp_pose[1] * 1000,  # Convert to mm
                'z': tcp_pose[2] * 1000,  # Convert to mm
                'rx': tcp_pose[3] * 57.2958,  # Convert to degrees
                'ry': tcp_pose[4] * 57.2958,  # Convert to degrees
                'rz': tcp_pose[5] * 57.2958   # Convert to degrees
            }
            self.logger.debug(f"TCP position updated: {self.current_position['cartesian']}")

        if joint_angles and len(joint_angles) >= 6:
            self.current_position['joint'] = {
                'j1': joint_angles[0] * 57.2958,  # Convert to degrees
                'j2': joint_angles[1] * 57.2958,  # Convert to degrees
                'j3': joint_angles[2] * 57.2958,  # Convert to degrees
                'j4': joint_angles[3] * 57.2958,  # Convert to degrees
                'j5': joint_angles[4] * 57.2958,  # Convert to degrees
                'j6': joint_angles[5] * 57.2958   # Convert to degrees
            }
            self.logger.debug(f"Joint angles updated: {self.current_position['joint']}")

        # Immediately trigger display update
        self._update_position_display()

    def _on_status_updated(self, status_data):
        """Handle status updates from controller."""
        pass  # Handled in _update_status_display

    def _on_connection_status_changed(self, connected: bool, message: str = ""):
        """Handle connection status changes."""
        if connected:
            self.status_value_label.setText("Connected")
            self.status_value_label.setObjectName("connectionStatus")

            # Update connection button to show "Disconnect" in red
            self.connection_button.setText("Disconnect")
            self.connection_button.setObjectName("disconnectButton")
        else:
            self.status_value_label.setText("Disconnected")
            self.status_value_label.setObjectName("connectionStatus")

            # Update connection button to show "Connect" in green
            self.connection_button.setText("Connect")
            self.connection_button.setObjectName("connectButton")

        # Re-apply style to update colors
        self.status_value_label.style().unpolish(self.status_value_label)
        self.status_value_label.style().polish(self.status_value_label)

        self.connection_button.style().unpolish(self.connection_button)
        self.connection_button.style().polish(self.connection_button)

        # Go to home only when connected and home is saved
        if hasattr(self, "go_to_home_btn"):
            self.go_to_home_btn.setEnabled(connected and bool(self.saved_home_joints))

    def closeEvent(self, event):
        """Handle window close event."""
        self.logger.info("Main window closing")
        if self.jog_controller:
            self.jog_controller.disconnect()
        event.accept()