    def _save_as_home(self) -> None:
        """Store current robot joint position as home and persist to config."""
        if not self.jog_controller or not self.jog_controller.websocket_receiver:
            QMessageBox.warning(self, "Home", "Robot not connected.")
            return
        if not self.jog_controller.websocket_receiver.is_connected():
            QMessageBox.warning(self, "Home", "Connect to the robot first.")
            return
        joints = self.jog_controller.websocket_receiver.get_joint_angles()
        if not joints or len(joints) != 6:
            QMessageBox.warning(
                self, "Home",
                "Could not read current position. Check that the robot is connected and position is updating."
            )
            return

        # Reject saving when position is still zeros (app has not received real data from robot yet)
        if all(abs(q) < 0.01 for q in joints):
            QMessageBox.warning(
                self, "Home",
                "The robot position is showing as zero. The application is not yet receiving "
                "position data from the robot.\n\n"
                "Wait a few seconds after connecting for the position to update (watch the position "
                "display on the main screen). Then try Save as home again.\n\n"
                "If the position never updates, the real-time connection (port 30003) may not be "
                "sending data in the expected format for this robot."
            )
            self.add_log_message("Save as home skipped: position not yet received from robot", "WARNING")
            return

        self.saved_home_joints = list(joints)
        self.config.setdefault("demo", {})["saved_home_joints"] = self.saved_home_joints
        config_path = Path("config/robot_config.yaml")
        try:
            if config_path.exists():
                with open(config_path, "r") as f:
                    full_config = yaml.safe_load(f) or {}
            else:
                full_config = {}
            full_config.setdefault("demo", {})["saved_home_joints"] = self.saved_home_joints
            with open(config_path, "w") as f:
                yaml.dump(full_config, f, default_flow_style=False, allow_unicode=True)
        except Exception as e:
            self.logger.warning("Could not write config: %s", e)
        self.go_to_home_btn.setEnabled(True)
        self.add_log_message("Home position saved", "INFO")

        # Show saved values in degrees so user can verify against robot screen (Base, Shoulder, Elbow, Wrist 1/2/3)
        deg = [j * 57.2957795 for j in self.saved_home_joints]
        msg = (
            "Current position saved as home.\n\n"
            "Verify against robot screen (Move Joints):\n"
            "  Base:    %+.2f deg\n"
            "  Shoulder: %+.2f deg\n"
            "  Elbow:   %+.2f deg\n"
            "  Wrist 1: %+.2f deg\n"
            "  Wrist 2: %+.2f deg\n"
            "  Wrist 3: %+.2f deg"
        ) % tuple(deg)
        QMessageBox.information(self, "Home", msg)

    def _go_to_home(self) -> None:
        """Move robot to saved home position."""
        if not self.saved_home_joints:
            QMessageBox.warning(self, "Home", "No home position saved. Use 'Save as home' first.")
            return
        if not self.jog_controller or not self.jog_controller.websocket_controller:
            QMessageBox.warning(self, "Home", "Robot not connected.")
            return
        if not self.jog_controller.websocket_controller.is_connected():
            QMessageBox.warning(self, "Home", "Connect to the robot first.")
            return
        ok = self.jog_controller.websocket_controller.move_joint(
            self.saved_home_joints,
            speed=0.35,
            acceleration=0.5,
            blend=0.0,
        )
        if ok:
            self.add_log_message("Moving to home", "INFO")
        else:
            self.add_log_message("Go to home command failed", "ERROR")
            QMessageBox.warning(self, "Home", "Failed to send move command.")

